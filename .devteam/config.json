{
  "pack": ".devteam/pack",
  "agent": {
    "runtime": "opencode",
    "command": "opencode",
    "args": [
      "run",
      "--format",
      "json",
      "--dir",
      "{dir}",
      "{prompt}"
    ],
    "discussArgs": [
      "--agent",
      "plan",
      "--prompt",
      "{prompt}"
    ],
    "model": "opencode-go/deepseek-v4.1-flash",
    "timeoutSeconds": 900,
    "ceilingSeconds": 7200,
    "stallSeconds": 900,
    "ceiling": "02:00:00",
    "stallWindowSeconds": 900,
    "roles": {}
  },
  "limits": {
    "maxRevisionRounds": 2,
    "maxDefineRounds": 2,
    "volatilePaths": [],
    "planReview": true,
    "planLint": true,
    "maxDesignComponents": 20,
    "sliceParts": 8,
    "reuseDesign": true,
    "ruleScope": true,
    "maxPlanReviewRounds": 1,
    "planReviewMinutes": 8,
    "planReviewQuietSeconds": 240,
    "planReviewAttempts": 3,
    "mergeReuse": true,
    "tensionDiagnosis": true,
    "fixOneAtATime": true,
    "learnWorkflows": true,
    "workflowRepeats": 5,
    "workflowRuns": 2,
    "workflowSeconds": 60,
    "preflight": true,
    "preflightMaxCalls": 8,
    "acceptScopeGrowth": true,
    "restoreOutOfScope": true,
    "itemChecks": "gates",
    "tensionMinutes": 4,
    "mergeReuseDays": 14,
    "shortcuts": true,
    "maxShortcuts": 2,
    "arbiterMinutes": 5,
    "maxArtifactAttempts": 2,
    "maxResumes": 2,
    "helperTools": false,
    "budgetUsd": 10,
    "parallelChallengers": true,
    "baselineChecks": true,
    "tidyStrayFiles": true,
    "quietGraceSeconds": 300,
    "noProgressMinutes": 20,
    "noProgressStopMinutes": 40,
    "progressPollSeconds": 15,
    "quickCheckSeconds": 30,
    "learnedTiers": true,
    "analystQuestionBudget": 8,
    "analystQuestionCap": 12,
    "maxAssumedTopics": 3,
    "strictRequirements": true,
    "maxRequirements": 25,
    "requirementsSignOff": true,
    "maxSignOffChanges": 3,
    "offerDocumentation": true,
    "documentByDefault": false,
    "stageMinutes": 45
  }
}